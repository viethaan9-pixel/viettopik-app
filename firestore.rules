rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isTeacher() {
      return request.auth != null && request.auth.token.email == 'viethaan9@topikviet.app';
    }
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isTeacher());
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.get('unlockAll', false) == false;
      allow update: if isTeacher() || (request.auth != null && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['unlockAll']));
      allow delete: if isTeacher();
    }
    // 열공 랭킹: one public line per student (name + points); the student (or the teacher) writes it, everyone signed in reads it
    match /board/{uid} {
      allow read: if request.auth != null;
      allow write: if isTeacher() || (request.auth != null && request.auth.uid == uid
                    && request.resource.data.pts is int && request.resource.data.pts >= 0);
    }
    // feedback mailbox: a signed-in student may send a short letter; only the teacher can read it
    match /feedback/{id} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 400
                    && request.resource.data.read == false;
      allow read, update, delete: if isTeacher();
    }
  }
}
