rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isTeacher() {
      return request.auth != null && request.auth.token.email == 'viethaan9@topikviet.app';
    }
    function isMe(uid) { return request.auth != null && request.auth.uid == uid; }
    // a student's own document: only these fields, progress map not too big, short name
    function okUser() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id','name','created','updated','lastSeen','p','unlockAll','mockGrade'])
        && (!('p' in d) || (d.p is map && d.p.size() <= 600))
        && (!('name' in d) || (d.name is string && d.name.size() <= 40));
    }
    match /users/{uid} {
      allow read: if isMe(uid) || isTeacher();
      allow create: if isMe(uid) && okUser() && request.resource.data.get('unlockAll', false) == false;
      allow update: if isTeacher() || (isMe(uid) && okUser()
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['unlockAll']));
      allow delete: if isTeacher();
    }
    // 열공 랭킹 (Chăm chỉ nhất): one short public line per student
    match /board/{uid} {
      allow read: if request.auth != null;
      allow write: if isTeacher() || (isMe(uid)
                    && request.resource.data.keys().hasOnly(['name','id','pts','at'])
                    && request.resource.data.name is string && request.resource.data.name.size() <= 40
                    && request.resource.data.pts is int && request.resource.data.pts >= 0 && request.resource.data.pts <= 2000000);
    }
    // feedback mailbox: a signed-in student may send a short letter; the teacher reads and replies.
    // a student can read only their own letters (to see the reply) and only mark the reply as seen
    match /feedback/{id} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 400
                    && request.resource.data.read == false
                    && !('reply' in request.resource.data);
      allow read: if isTeacher() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update: if isTeacher()
                    || (request.auth != null && resource.data.uid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replySeen'])
                        && request.resource.data.replySeen == true);
      allow delete: if isTeacher();
    }
  }
}
